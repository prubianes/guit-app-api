{
  "openapi": "3.0.0",
  "info": {
    "title": "Guit App API",
    "version": "2.0.0"
  },
  "tags": [
    { "name": "Auth", "description": "Authentication endpoints (v2)" },
    { "name": "Me", "description": "Authenticated user endpoints (v2)" },
    { "name": "Category", "description": "Category management" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": {}
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" },
          "tokenType": { "type": "string", "example": "Bearer" },
          "accessTokenExpiresIn": { "type": "integer" },
          "refreshTokenExpiresIn": { "type": "integer" }
        },
        "required": ["accessToken", "refreshToken", "tokenType", "accessTokenExpiresIn", "refreshTokenExpiresIn"]
      },
      "UserPublic": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "email", "createdAt", "updatedAt"]
      }
    }
  },
  "paths": {
    "/api/v2/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                },
                "required": ["name", "email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered" },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "examples": {
                  "validation": {
                    "value": {
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "Invalid request body"
                      }
                    }
                  }
                }
              }
            }
          },
          "409": { "description": "Email already exists" }
        }
      }
    },
    "/api/v2/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login with email and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login success",
            "content": {
              "application/json": {
                "examples": {
                  "success": {
                    "value": {
                      "data": {
                        "user": {
                          "id": 1,
                          "name": "Alice",
                          "email": "alice@example.com",
                          "createdAt": "2026-03-05T00:00:00.000Z",
                          "updatedAt": "2026-03-05T00:00:00.000Z"
                        },
                        "tokens": {
                          "accessToken": "<jwt>",
                          "refreshToken": "<jwt>",
                          "tokenType": "Bearer",
                          "accessTokenExpiresIn": 900,
                          "refreshTokenExpiresIn": 604800
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v2/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Issue a new access/refresh token pair",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": { "type": "string" }
                },
                "required": ["refreshToken"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token pair refreshed" },
          "401": { "description": "Invalid/expired token" }
        }
      }
    },
    "/api/v2/me": {
      "get": {
        "tags": ["Me"],
        "summary": "Get authenticated user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated user profile",
            "content": {
              "application/json": {
                "examples": {
                  "success": {
                    "value": {
                      "data": {
                        "id": 1,
                        "name": "Alice",
                        "email": "alice@example.com",
                        "createdAt": "2026-03-05T00:00:00.000Z",
                        "updatedAt": "2026-03-05T00:00:00.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "examples": {
                  "unauthorized": {
                    "value": {
                      "error": {
                        "code": "UNAUTHORIZED",
                        "message": "Authentication required"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/me/accounts": {
      "get": {
        "tags": ["Me"],
        "summary": "List authenticated user accounts",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of accounts" },
          "401": { "description": "Authentication required" }
        }
      },
      "post": {
        "tags": ["Me"],
        "summary": "Create account for authenticated user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Account created" },
          "400": { "description": "Validation error" },
          "401": { "description": "Authentication required" }
        }
      }
    },
    "/api/v2/me/accounts/{accountId}": {
      "get": { "tags": ["Me"], "summary": "Get account by id", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Account found" }, "401": { "description": "Authentication required" }, "404": { "description": "Account not found" } } },
      "patch": { "tags": ["Me"], "summary": "Update account by id", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Account updated" }, "400": { "description": "Validation error" }, "401": { "description": "Authentication required" }, "404": { "description": "Account not found" } } },
      "delete": { "tags": ["Me"], "summary": "Delete account by id", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Account deleted" }, "401": { "description": "Authentication required" }, "404": { "description": "Account not found" } } }
    },
    "/api/v2/me/transactions": {
      "get": { "tags": ["Me"], "summary": "List transactions", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "List of transactions" }, "401": { "description": "Authentication required" } } },
      "post": { "tags": ["Me"], "summary": "Create transaction", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Transaction created" }, "400": { "description": "Validation error" }, "401": { "description": "Authentication required" }, "404": { "description": "Account/category not found" } } }
    },
    "/api/v2/me/transactions/{transactionId}": {
      "get": { "tags": ["Me"], "summary": "Get transaction by id", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Transaction found" }, "401": { "description": "Authentication required" }, "404": { "description": "Transaction not found" } } },
      "patch": { "tags": ["Me"], "summary": "Update transaction by id", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Transaction updated" }, "400": { "description": "Validation error" }, "401": { "description": "Authentication required" }, "404": { "description": "Transaction/account/category not found" } } },
      "delete": { "tags": ["Me"], "summary": "Delete transaction by id", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Transaction deleted" }, "401": { "description": "Authentication required" }, "404": { "description": "Transaction not found" } } }
    },
    "/api/v2/me/budgets": {
      "get": { "tags": ["Me"], "summary": "List budgets", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "List of budgets" }, "401": { "description": "Authentication required" } } },
      "post": { "tags": ["Me"], "summary": "Create budget", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Budget created" }, "400": { "description": "Validation error" }, "401": { "description": "Authentication required" } } }
    },
    "/api/v2/me/budgets/{budgetId}": {
      "get": { "tags": ["Me"], "summary": "Get budget by id", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Budget found" }, "401": { "description": "Authentication required" }, "404": { "description": "Budget not found" } } },
      "patch": { "tags": ["Me"], "summary": "Update budget by id", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Budget updated" }, "400": { "description": "Validation error" }, "401": { "description": "Authentication required" }, "404": { "description": "Budget not found" } } },
      "delete": { "tags": ["Me"], "summary": "Delete budget by id", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Budget deleted" }, "401": { "description": "Authentication required" }, "404": { "description": "Budget not found" } } }
    },
    "/category": {
      "post": {
        "tags": ["Category"],
        "summary": "Create a new category",
        "responses": {
          "200": { "description": "Category created" }
        }
      },
      "get": {
        "tags": ["Category"],
        "summary": "Get all categories",
        "responses": {
          "200": { "description": "List of categories" }
        }
      }
    },
    "/category/{id}": {
      "get": {
        "tags": ["Category"],
        "summary": "Get category by ID",
        "responses": {
          "200": { "description": "Category found" },
          "404": { "description": "Category not found" }
        }
      },
      "put": {
        "tags": ["Category"],
        "summary": "Update category by ID",
        "responses": {
          "200": { "description": "Category updated" },
          "404": { "description": "Category not found" }
        }
      },
      "delete": {
        "tags": ["Category"],
        "summary": "Delete category by ID",
        "responses": {
          "200": { "description": "Category deleted" },
          "404": { "description": "Category not found" }
        }
      }
    }
  }
}
