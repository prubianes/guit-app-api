# Example environment variables for local development
# Copy this file to .env and update values before running the app

# SQLite connection string (default used by current Prisma adapter)
DATABASE_URL="file:./guit-app/prisma/dev.db"

# Optional: separate test database URL
TEST_DATABASE_URL="file:./guit-app/prisma/test.db"

# App configuration
PORT=3000
NODE_ENV=development

# Auth / token settings
AUTH_JWT_SECRET="change-this-secret-in-real-environments"
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
